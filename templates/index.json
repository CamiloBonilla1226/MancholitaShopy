                    "corner_radius": 0,
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "text_xeyLkL"
              ]
            },
            "accordion_row_8agQiH": {
              "type": "_accordion-row",
              "settings": {
                "heading": "¿Qué métodos de pago aceptan?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_MAF6KJ": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Aceptamos pagos por transferencia, consignación y medios digitales. La información de pago se comparte al momento de confirmar tu pedido por WhatsApp.</p>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "rte",
