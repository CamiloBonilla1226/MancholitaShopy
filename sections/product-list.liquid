

{% liquid
  assign visible_items = 4
  assign max_items = 12
  assign recent_products = blank

  if section.settings.collection != blank and shop.products_count != 0
    assign recent_products = section.settings.collection.products | sort: 'created_at' | reverse
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="product-list-{{ section.id }}"
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <style>
    #product-list-{{ section.id }} .resource-list__item--new-badge {
      position: relative;
    }

    #product-list-{{ section.id }} .product-list__badge-new {
      position: absolute;
      top: 0.6rem;
      left: 0.6rem;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.3rem 0.62rem;
      border-radius: 999px;
      background: #0b2a5b;
      color: #ffffff;
      box-shadow: 0 0.25rem 0.75rem rgb(0 0 0 / 16%);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: none;
      line-height: 1;
      pointer-events: none;
    }

    {% if template.name == 'index' %}
      #product-list-{{ section.id }} {
        --product-list-accent: #0b2a5b;
        --product-list-soft-accent: #eef3f8;
      }

      #product-list-{{ section.id }} .section-resource-list__header {
        max-width: 42rem;
        margin-inline: auto;
        text-align: center;
      }

      #product-list-{{ section.id }} .section-resource-list__header .group-block {
        justify-self: center;
      }

      #product-list-{{ section.id }} .section-resource-list__header .group-block-content,
      #product-list-{{ section.id }} .section-resource-list__header .text-block {
        align-items: center;
      }

      #product-list-{{ section.id }} .section-resource-list__header .text-block:first-child :is(h1, h2, h3) {
        max-width: 100%;
        margin: 0;
        font-size: 1.6rem;
        font-weight: 800;
        line-height: 1.08;
        letter-spacing: 0;
        text-align: center;
      }

      #product-list-{{ section.id }} .section-resource-list__header .text-block:first-child :is(h1, h2, h3)::after {
        content: '';
        display: none;
        width: 2.6rem;
        height: 0.2rem;
        margin: 0.7rem auto 0;
        border-radius: 999px;
        background: var(--product-list-accent);
      }

      #product-list-{{ section.id }} .section-resource-list__header .text-block:nth-of-type(2) p {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 0.38rem 0.78rem;
        border: 1px solid rgb(11 42 91 / 14%);
        border-radius: 999px;
        background: var(--product-list-soft-accent);
        color: var(--product-list-accent);
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0;
      }

      #product-list-{{ section.id }} .resource-list {
        margin-block-start: 0.25rem;
      }

      #product-list-{{ section.id }} .card-gallery {
        overflow: hidden;
        background: #f7f8fa;
        box-shadow: 0 0.7rem 1.8rem rgb(0 0 0 / 8%);
        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease;
      }

      #product-list-{{ section.id }} .card-gallery > a > slideshow-component > slideshow-container {
        overflow: hidden;
        background: transparent;
      }

      #product-list-{{ section.id }} .card-gallery > a > slideshow-component > slideshow-container > slideshow-slides {
        gap: 0;
        margin-block: 0;
        padding: 0;
        scroll-padding-inline: 0;
      }

      #product-list-{{ section.id }} .card-gallery slideshow-slide.product-media-container,
      #product-list-{{ section.id }} .card-gallery .product-media,
      #product-list-{{ section.id }} .card-gallery .product-media__image {
        width: 100%;
        height: 100%;
      }

      #product-list-{{ section.id }} .card-gallery .product-media__image {
        object-fit: cover;
      }

      #product-list-{{ section.id }} .product-card__content {
        padding-block-end: 0.2rem;
      }

      @media (any-pointer: fine) and (prefers-reduced-motion: no-preference) {
        #product-list-{{ section.id }} .product-card:hover .card-gallery {
          transform: translateY(-0.18rem);
          box-shadow: 0 1rem 2.4rem rgb(0 0 0 / 12%);
        }
      }

      @media screen and (min-width: 750px) {
        #product-list-{{ section.id }} {
          overflow: visible;
        }

        #product-list-{{ section.id }} .section-resource-list__header {
          max-width: 52rem;
          margin-block-end: 1.1rem;
        }

        #product-list-{{ section.id }} .section-resource-list__header .text-block:first-child :is(h1, h2, h3) {
          max-width: none;
          font-size: 2rem;
          line-height: 1.02;
        }

        #product-list-{{ section.id }} .section-resource-list__header .text-block:nth-of-type(2) p {
          padding: 0;
          border: 0;
          background: transparent;
          color: rgb(var(--color-foreground-rgb) / 78%);
          font-size: 1rem;
          font-weight: 500;
          line-height: 1.15;
        }

        #product-list-{{ section.id }} .resource-list {
          margin-block-start: 0.35rem;
        }

        #product-list-{{ section.id }} .resource-list__carousel {
          --peek-next-slide-size: 0px;
          overflow: visible;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container {
          overflow: visible;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container > slideshow-slides {
          gap: var(--resource-list-column-gap);
          margin-block: 0;
          padding-block: 1.25rem 0.25rem;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container > slideshow-slides > .resource-list__slide {
          scroll-snap-align: start;
        }

        #product-list-{{ section.id }} .product-list__badge-new,
        #product-list-{{ section.id }} product-price {
          display: none;
        }

        #product-list-{{ section.id }} .card-gallery {
          --gallery-aspect-ratio: 1 / 1;
          border-radius: 0;
          background: #f7f8fa;
          box-shadow: none;
        }

        #product-list-{{ section.id }} .product-card__content {
          align-items: center;
          gap: 0.75rem;
          padding-block-end: 0;
        }

        #product-list-{{ section.id }} .product-card__content .text-block {
          align-items: center;
        }

        #product-list-{{ section.id }} .product-card__content .text-block p {
          margin: 0;
          color: rgb(var(--color-foreground-rgb) / 88%);
          font-size: 0.9rem;
          font-weight: 500;
          line-height: 1.2;
          text-align: center;
          text-transform: uppercase;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container > slideshow-arrows {
          inset-block: 1.25rem 3rem;
          padding-inline: 0.75rem !important;
          align-items: center;
          mix-blend-mode: normal;
          pointer-events: none;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container > slideshow-arrows > .slideshow-control {
          display: flex;
          width: 2.75rem;
          min-width: 2.75rem;
          height: 2.75rem;
          min-height: 2.75rem;
          align-items: center;
          justify-content: center;
          padding: 0;
          border-radius: 0.4rem;
          background: #000000;
          color: #ffffff;
          box-shadow: 0 0.55rem 1.15rem rgb(0 0 0 / 24%);
          opacity: 1;
          animation: none;
          transform: none;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container > slideshow-arrows > .slideshow-control .svg-wrapper {
          width: 1.05rem;
          height: 1.05rem;
        }

        @media (any-pointer: fine) and (prefers-reduced-motion: no-preference) {
          #product-list-{{ section.id }} .product-card:hover .card-gallery {
            transform: translateY(-0.12rem);
            box-shadow: none;
          }
        }
      }

      @media screen and (max-width: 749px) {
        #product-list-{{ section.id }} .section-resource-list__header .text-block:first-child :is(h1, h2, h3) {
          font-size: 1.7rem;
          line-height: 1.05;
        }

        #product-list-{{ section.id }} .section-resource-list__header .text-block:first-child :is(h1, h2, h3)::after {
          margin-block-start: 0.55rem;
        }

        #product-list-{{ section.id }} .section-resource-list__header .text-block:nth-of-type(2) p {
          padding: 0;
          border: 0;
          background: transparent;
          color: rgb(var(--color-foreground-rgb) / 76%);
          font-size: 1rem;
          font-weight: 500;
        }

        #product-list-{{ section.id }} .resource-list__carousel {
          --mobile-product-card-width: min(74vw, 320px);
          margin-block-start: 0.75rem;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container {
          background: transparent;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container > slideshow-slides {
          gap: 0 !important;
          margin-block: 0;
          padding-block: 1.45rem 0.9rem;
          padding-inline: 0 !important;
          scroll-padding-inline: 0 !important;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container > slideshow-slides > .resource-list__slide {
          width: 100% !important;
          flex-basis: 100%;
          display: flex;
          justify-content: center;
          scroll-snap-align: center;
        }

        #product-list-{{ section.id }} .resource-list__carousel .resource-list__item {
          width: var(--mobile-product-card-width);
          max-width: var(--mobile-product-card-width);
        }

        #product-list-{{ section.id }} .product-list__badge-new,
        #product-list-{{ section.id }} product-price {
          display: none;
        }

        #product-list-{{ section.id }} .card-gallery {
          --gallery-aspect-ratio: 1 / 1;
          border-radius: 0.35rem;
          background: #f7f8fa;
          box-shadow: none;
        }

        #product-list-{{ section.id }} .product-card__content {
          align-items: center;
          padding-block-end: 0;
          gap: 0.85rem;
        }

        #product-list-{{ section.id }} .product-card__content .text-block {
          align-items: center;
        }

        #product-list-{{ section.id }} .product-card__content .text-block p {
          margin: 0;
          color: rgb(var(--color-foreground-rgb) / 88%);
          font-size: 0.9rem;
          font-weight: 600;
          line-height: 1.2;
          text-align: center;
          text-transform: uppercase;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container > slideshow-arrows {
          padding-inline: 0.15rem !important;
          align-items: center;
          pointer-events: none;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container > slideshow-arrows > .slideshow-control {
          display: flex;
          width: 2.75rem;
          min-width: 2.75rem;
          height: 2.75rem;
          min-height: 2.75rem;
          padding: 0;
          border-radius: 0.45rem;
          background: #000000;
          color: #ffffff;
          box-shadow: 0 0.55rem 1.15rem rgb(0 0 0 / 24%);
          opacity: 1;
          animation: none;
          transform: none;
        }

        #product-list-{{ section.id }} > .resource-list.resource-list__carousel > div > slideshow-component.resource-list__carousel > slideshow-container > slideshow-arrows > .slideshow-control .svg-wrapper {
          width: 1.05rem;
          height: 1.05rem;
        }
      }
    {% endif %}
  </style>

  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% capture list_items %}
    {% if recent_products != blank %}
      {% for product in recent_products limit: max_items %}
        <div
          class="resource-list__item resource-list__item--new-badge"
        >
          <span class="product-list__badge-new">Nuevo</span>

          {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% else %}
      {% for i in (1..max_items) %}
        <div
          class="resource-list__item"
        >
          {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    visible_items: visible_items,
    slide_count: max_items,
    content_type: 'products',
    test_id: 'resource-list-grid'
  %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% if template.name == 'index' %}
  <script>
    (() => {
      const section = document.getElementById('product-list-{{ section.id }}');
      if (!section) return;

      const desktopQuery = window.matchMedia('(min-width: 750px)');
      let autoplayTimer;

      const getCarousel = () => section.querySelector('slideshow-component.resource-list__carousel');

      const syncInfiniteControls = (carousel) => {
        carousel.setAttribute('infinite', '');
        carousel.current = carousel.current;
      };

      const startAutoplay = () => {
        window.clearInterval(autoplayTimer);

        const carousel = getCarousel();
        if (!carousel) return;

        syncInfiniteControls(carousel);

        if (!desktopQuery.matches) return;

        autoplayTimer = window.setInterval(() => {
          if (!desktopQuery.matches || document.hidden || carousel.matches(':hover')) return;
          carousel.next(undefined, { animate: true });
        }, 5000);
      };

      const boot = () => window.requestAnimationFrame(startAutoplay);

      if (customElements.get('slideshow-component')) {
        boot();
      } else {
        customElements.whenDefined('slideshow-component').then(boot);
      }

      desktopQuery.addEventListener('change', startAutoplay);

      document.addEventListener('shopify:section:unload', (event) => {
        if (event.target === section || (event.target instanceof Element && event.target.contains(section))) {
          window.clearInterval(autoplayTimer);
        }
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "t:names.product_list",
  "class": "ui-test-product-list",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "editorial",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.layout_type != 'editorial' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "60cqw",
          "label": "t:options.one_number"
        },
        {
          "value": "44cqw",
          "label": "t:options.two_number"
        }
      ],
      "default": "60cqw",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid' or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.layout_type == 'grid'}}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.products_grid",
      "category": "t:categories.products",
      "settings": {
        "collection": "",
        "max_products": 12,
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 8,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "gap": 28,
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "t:names.header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
